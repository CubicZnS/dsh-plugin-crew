{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "crew/task.schema.json",
  "title": "CrewTask",
  "type": "object",
  "required": [
    "id",
    "subject",
    "status",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task-[0-9]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string"
    },
    "type": {
      "enum": [
        "code",
        "research",
        "content",
        "monitor"
      ]
    },
    "status": {
      "enum": [
        "todo",
        "claimed",
        "done",
        "failed",
        "blocked"
      ]
    },
    "priority": {
      "type": "integer",
      "default": 0
    },
    "owner": {
      "type": "string"
    },
    "deps": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^task-[0-9]+$"
      },
      "uniqueItems": true
    },
    "writeScopes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "string",
      "description": "盲审依据：可执行、可判定的验收标准"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "failures": {
      "type": "integer",
      "minimum": 0,
      "description": "真实失败次数，消耗重试预算；崩溃中断不计"
    },
    "reason": {
      "type": "string",
      "description": "blocked 的原因码：retry-exhausted / approval-timeout / rejected-by-human"
    },
    "blockedReason": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
